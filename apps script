/** 5.3 — Precision stance (Part 6) */

const PRECISION_SIGNALS = {
  NEUTRAL: [
    "number", "numbers", "math", "model output", "projection", "expected value", "ev"
  ],
  OVERCONFIDENT: [
    "exact", "precise", "proves", "clearly shows", "guarantees", "certain", "cannot be wrong"
  ],
  SKEPTICAL: [
    "even though", "despite", "but the model", "on paper", "the numbers say",
    "looks good numerically", "still misleading"
  ]
};

function collectPrecisionText_() {
  const rationale = getText_(BOW.SHEETS.SHOCK, BOW.CELLS.SHOCK_RATIONALE);
  const action = getText_(BOW.SHEETS.SHOCK, BOW.CELLS.SHOCK_ACTION);
  return normalizeText_([rationale, action].join(" "));
}

function countSignals_(text, tokens) {
  let count = 0;
  tokens.forEach(t => {
    if (text.indexOf(t) !== -1) count += 1;
  });
  return count;
}

function interpretPrecisionStance_() {
  const text = collectPrecisionText_();
  if (!text) {
    return {
      stance: "unknown",
      narration:
        "You didn’t rely on numerical certainty to explain the decision — keeping the focus on context."
    };
  }

  const neutralHits = countSignals_(text, PRECISION_SIGNALS.NEUTRAL);
  const overconfidentHits = countSignals_(text, PRECISION_SIGNALS.OVERCONFIDENT);
  const skepticalHits = countSignals_(text, PRECISION_SIGNALS.SKEPTICAL);

  if (overconfidentHits > 0 && skepticalHits === 0) {
    return {
      stance: "precision_trap",
      narration:
        "The model’s numerical confidence played a large role in the reasoning. This is where precision can quietly replace judgment."
    };
  }
  if (skepticalHits > 0) {
    return {
      stance: "precision_aware",
      narration:
        "You acknowledged what the numbers suggested without letting numerical precision override contextual judgment."
    };
  }
  if (neutralHits > 0) {
    return {
      stance: "precision_neutral",
      narration:
        "You treated the model’s output as informative, but not decisive — keeping judgment outside the math."
    };
  }
  return {
    stance: "precision_ignored",
    narration:
      "You focused on assumptions and context rather than numerical certainty."
  };
}

