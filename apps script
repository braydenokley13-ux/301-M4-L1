function normalizeAssumptionText_(text) {
  return normalizeText_(text);
}

function findAssumptionCategory_(normalizedText) {
  if (!normalizedText) return null;
  let bestMatch = null;
  let bestScore = 0;

  ASSUMPTION_TAXONOMY.forEach(category => {
    let score = 0;
    category.keywords.forEach(keyword => {
      if (normalizedText.indexOf(keyword) !== -1) score += 1;
    });
    if (score > bestScore) {
      bestScore = score;
      bestMatch = category;
    }
  });

  return bestScore > 0 ? bestMatch : null;
}

function narrateAssumptionAwareness_() {
  const raw = getText_(BOW.SHEETS.SHOCK, BOW.CELLS.SHOCK_SNAPPED);
  const normalized = normalizeAssumptionText_(raw);

  const category = findAssumptionCategory_(normalized);
  if (!category) {
    return {
      found: false,
      assumptionId: null,
      narration:
        "You flagged that a core assumption stopped holding, even if the exact category wasn’t cleanly named."
    };
  }

  return {
    found: true,
    assumptionId: category.id,
    narration: category.narration
  };
}

