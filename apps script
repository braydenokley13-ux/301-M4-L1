function normalizeDecisionText_(text) {
  return normalizeText_(text);
}

function detectDecisionFraming_() {
  const raw = getText_(BOW.SHEETS.SHOCK, BOW.CELLS.SHOCK_ACTION);
  const text = normalizeDecisionText_(raw);

  if (!text) {
    return {
      found: false,
      framing: null,
      narration:
        "You paused before committing to an action — a reminder that decisions require explicit ownership."
    };
  }

  for (const key in DECISION_FRAMING) {
    const frame = DECISION_FRAMING[key];
    const hit = frame.keywords.some(k => text.indexOf(k) !== -1);
    if (hit) {
      return {
        found: true,
        framing: key.toLowerCase(),
        narration: frame.narration,
        lesson: frame.lesson
      };
    }
  }

  return {
    found: true,
    framing: "custom",
    narration:
      "You made an explicit leadership call rather than deferring blindly to the model.",
    lesson:
      "Executive judgment begins where automated guidance ends."
  };
}

/** =========================
 * 6) REFLECTION COMPOSER (Part 8)
 * ========================= */

function composeLearningReflection_() {
  const insight = detectInsight_();
  const assumption = narrateAssumptionAwareness_();
  const context = narrateContextShift_();
  const precision = interpretPrecisionStance_();
  const decision = detectDecisionFraming_();

  const lines = [];

  if (assumption && assumption.narration) {
    lines.push(assumption.narration);
  } else {
    lines.push(
      "You recognized that the model rested on assumptions that quietly shaped its guidance."
    );
  }

  if (context && context.found && context.narration && context.narration.length) {
    context.narration.forEach(n => lines.push(n));
  } else {
    lines.push(
      "You noticed the terrain shifting in ways the model was not designed to track."
    );
  }

  if (precision && precision.narration) {
    lines.push(precision.narration);
  }

  if (decision && decision.narration) {
    lines.push(decision.narration);
  }

  if (insight && insight.insightLevel) {
    if (insight.insightLevel === "executive") {
      lines.push(BOW.VOICE.AFFIRM.EXECUTIVE);
    } else if (insight.insightLevel === "contextual") {
      lines.push(BOW.VOICE.AFFIRM.CONTEXTUAL);
    } else if (insight.insightLevel === "structural") {
      lines.push(BOW.VOICE.AFFIRM.STRUCTURAL);
    }
  }

  return lines.join(" ");
}

function writeLearningReflection_() {
  const sheet = getSheet_(BOW.SHEETS.FINISH);
  const anchor = BOW.CELLS.FINISH_REFLECTION_BLOCK;
  const reflection = composeLearningReflection_();

  sheet.getRange(anchor).setValue(
    "What You Demonstrated:\n\n" + reflection
  );
}

/** =========================
