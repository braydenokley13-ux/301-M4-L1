/** =========================
 * 2) CORE HELPERS
 * ========================= */

function getSheet_(name) {
  const sh = SpreadsheetApp.getActive().getSheetByName(name);
  if (!sh) throw new Error("Missing required sheet: " + name);
  return sh;
}

function getValue_(sheetName, cellA1) {
  return getSheet_(sheetName).getRange(cellA1).getValue();
}

function setValue_(sheetName, cellA1, value) {
  getSheet_(sheetName).getRange(cellA1).setValue(value);
}

function getText_(sheetName, cellA1) {
  const v = getValue_(sheetName, cellA1);
  return String(v || "").trim();
}

function normalizeText_(text) {
  return String(text || "")
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

