function identityStatus_() {
  const name = getText_(BOW.SHEETS.START, BOW.CELLS.STUDENT_NAME);
  const email = getText_(BOW.SHEETS.START, BOW.CELLS.STUDENT_EMAIL);

  if (!name || !email) {
    return {
      ready: false,
      reason: "missing_identity",
      message: BOW.VOICE.STATUS.MISSING_ID
    };
  }
  return { ready: true };
}

/** 3.2 — Assumptions tagged (BETS_AND_ASSUMPTIONS) */

function assumptionsCompletionStatus_() {
  const sh = getSheet_(BOW.SHEETS.ASSUMPTIONS);

  const whereVals = sh.getRange(BOW.CELLS.ASSUMPTION_WHERE_RANGE).getValues().flat();
  const fragVals = sh.getRange(BOW.CELLS.ASSUMPTION_FRAGILITY_RANGE).getValues().flat();

  const missingWhere = whereVals.some(v => !v);
  const missingFrag = fragVals.some(v => !v);

  if (missingWhere || missingFrag) {
    return {
      ready: false,
      reason: "assumptions_incomplete",
      message: BOW.VOICE.NUDGES.NEED_ASSUMPTIONS
    };
  }
  return { ready: true };
}

/** 3.3 — Stability signals (WHY_IT_WORKED_BEFORE) */

function stabilityCompletionStatus_() {
  const sh = getSheet_(BOW.SHEETS.STABILITY);
  const vals = sh.getRange(BOW.CELLS.STABILITY_PRESENT_RANGE).getValues().flat();

  // Require at least 3 stability signals to be tagged as present / not blank
  const nonEmpty = vals.filter(v => v !== "" && v !== null).length;

  if (nonEmpty < 3) {
    return {
      ready: false,
      reason: "stability_incomplete",
      message: BOW.VOICE.NUDGES.NEED_STABILITY
    };
  }
  return { ready: true };
}

