function computeCompletionPct_() {
  let completed = 0;
  let total = 5; // identity, assumptions, stability, decision, insight

  if (identityStatus_().ready) completed++;
  if (assumptionsCompletionStatus_().ready) completed++;
  if (stabilityCompletionStatus_().ready) completed++;
  if (decisionInputsStatus_().ready) completed++;
  if (insightCompletionStatus_().ready) completed++;

  return completed / total;
}

function determineCompletionTier_() {
  const assumptionsReady = assumptionsCompletionStatus_().ready;
  const stabilityReady = stabilityCompletionStatus_().ready;
  const insight = detectInsight_();

  if (!assumptionsReady || !stabilityReady) {
    return BOW.LABELS.TIER_BRONZE;
  }

  if (insight && insight.insightLevel === "executive") {
    return BOW.LABELS.TIER_GOLD;
  }

  if (insight && (insight.insightLevel === "contextual" || insight.insightLevel === "structural")) {
    return BOW.LABELS.TIER_SILVER;
  }

  return BOW.LABELS.TIER_BRONZE;
}

function assumptionsFullyCompleted_() {
  const sh = getSheet_(BOW.SHEETS.ASSUMPTIONS);
  const whereVals = sh.getRange(BOW.CELLS.ASSUMPTION_WHERE_RANGE).getValues().flat();
  const fragVals = sh.getRange(BOW.CELLS.ASSUMPTION_FRAGILITY_RANGE).getValues().flat();
  return whereVals.every(v => v) && fragVals.every(v => v);
}

function ensureClaimCode_() {
  const stateSh = getSheet_(BOW.SHEETS.STATE);
  const existing = String(stateSh.getRange(BOW.CELLS.STATE_CLAIM).getValue() || "").trim();
  if (existing) return existing;

  const cfg = getSheet_(BOW.SHEETS.ADMIN);
  const prefix = String(cfg.getRange("C10").getValue() || "BOW-301-M4L1-").trim();
  const date = Utilities.formatDate(new Date(), BOW.TZ, "yyyyMMdd");
  const rand = Math.floor(1000 + Math.random() * 9000);
  const code = prefix + date + "-" + rand;

  stateSh.getRange(BOW.CELLS.STATE_CLAIM).setValue(code);
  return code;
}

function collectCompletionMetadata_() {
  const stateSh = getSheet_(BOW.SHEETS.STATE);

  return {
    timestamp: new Date(),
    studentName: getText_(BOW.SHEETS.START, BOW.CELLS.STUDENT_NAME),
    studentEmail: getText_(BOW.SHEETS.START, BOW.CELLS.STUDENT_EMAIL),
    tier: determineCompletionTier_(),
    pct: computeCompletionPct_(),
    claimCode: ensureClaimCode_()
  };
}

/** Full readiness interpreter — structure + minimum insight */
function interpretReadiness_() {
  const idCheck = identityStatus_();
  if (!idCheck.ready) return idCheck;

  const assumptionsCheck = assumptionsCompletionStatus_();
  if (!assumptionsCheck.ready) return assumptionsCheck;

  const stabilityCheck = stabilityCompletionStatus_();
  if (!stabilityCheck.ready) return stabilityCheck;

  const decisionCheck = decisionInputsStatus_();
  if (!decisionCheck.ready) return decisionCheck;

  const insightCheck = insightCompletionStatus_();
  if (!insightCheck.ready) return insightCheck;

  return {
    ready: true,
    reason: "ready",
    message: BOW.VOICE.STATUS.READY
  };
}

function recognizeCompletion_() {
  const readiness = interpretReadiness_();
  if (!readiness.ready) {
    return {
      completed: false,
      message: readiness.message
    };
  }

  // Write reflection
  writeLearningReflection_();

  // Compute and persist metadata
  const meta = collectCompletionMetadata_();

  // Update STATE
  setValue_(BOW.SHEETS.STATE, BOW.CELLS.STATE_STATUS, BOW.LABELS.STATE_PASS);
  setValue_(BOW.SHEETS.STATE, BOW.CELLS.STATE_TIER, meta.tier);
  setValue_(BOW.SHEETS.STATE, BOW.CELLS.STATE_PCT, meta.pct);

  // Update FINISH_AND_CLAIM
  setValue_(BOW.SHEETS.FINISH, BOW.CELLS.FINISH_STATUS, "COMPLETE");
  setValue_(BOW.SHEETS.FINISH, BOW.CELLS.FINISH_TIER, meta.tier);
  setValue_(BOW.SHEETS.FINISH, BOW.CELLS.FINISH_CLAIM, meta.claimCode);

  return {
    completed: true,
    message: BOW.VOICE.STATUS.READY,
    metadata: meta
  };
}

/** =========================
 * 8) LOGGING + EMAIL (Part 10)
 * ========================= */

function alreadyLogged_(claimCode) {
  const log = getSheet_(BOW.SHEETS.LOG);
  const lastRow = log.getLastRow();
  if (lastRow < 2) return false;

  const codes = log
    .getRange(2, 5, lastRow - 1, 1)
    .getValues()
    .flat()
    .map(v => String(v || "").trim());

  return codes.indexOf(claimCode) !== -1;
}

function appendToLog_(meta) {
  const log = getSheet_(BOW.SHEETS.LOG);
  log.appendRow([
    meta.timestamp,
    meta.studentName,
    meta.studentEmail,
    meta.tier,
    meta.claimCode,
    meta.pct
  ]);
}

function composeCompletionEmail_(meta) {
  const subject = BOW.VOICE.EMAIL.SUBJECT_DEFAULT;
  const body =
    "Hi " + (meta.studentName || "there") + ",\n\n" +
    BOW.VOICE.EMAIL.BODY_OPEN + "\n\n" +
    "Your claim code:\n" +
    meta.claimCode + "\n\n" +
    "What this means:\n" +
    BOW.VOICE.EMAIL.BODY_CORE + "\n\n" +
    "This isn’t about being “right.”\n" +
    "It’s about recognizing when a good model becomes a bad guide because the world moved.\n\n" +
    BOW.VOICE.EMAIL.BODY_CLOSE + "\n\n" +
    "— " + BOW.PRODUCT.BRAND;

  return { subject, body };
}

/** =========================
 * 9) UI MENU + ORCHESTRATOR
 * ========================= */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu("Track 301")
    .addItem("Finalize Decision Room & Send Email", "finalizeDecisionRoom_")
    .addToUi();
}

function finalizeDecisionRoom_() {
  try {
    const result = recognizeCompletion_();

    if (!result.completed) {
      SpreadsheetApp.getUi().alert(result.message);
      return;
    }

    const meta = result.metadata;

    if (alreadyLogged_(meta.claimCode)) {
      SpreadsheetApp.getUi().alert(
        "This Decision Room has already been finalized and emailed."
      );
      return;
    }

    appendToLog_(meta);

    const email = composeCompletionEmail_(meta);
    MailApp.sendEmail({
      to: meta.studentEmail,
      subject: email.subject,
      body: email.body,
      name: BOW.PRODUCT.BRAND
    });

    SpreadsheetApp.getUi().alert(
      "Decision Room finalized. Reflection written and email sent."
    );
  } catch (err) {
    SpreadsheetApp.getUi().alert(
      "Something went wrong while finalizing the Decision Room:\n\n" +
      err.message
    );
  }
}
