const SIGNALS = {
  ASSUMPTION: [
    "assum", "bet", "depend", "relied", "quiet", "baked in"
  ],
  CONTEXT: [
    "context", "environment", "terrain", "conditions", "setting", "landscape"
  ],
  CHANGE: [
    "change", "shift", "adapt", "broke", "moved", "no longer", "stopped"
  ],
  PRECISION_TRAP: [
    "precise", "precision", "accurate", "accuracy", "decimal", "exact"
  ]
};

function hasSignal_(normalizedText, signalList) {
  return signalList.some(token => normalizedText.indexOf(token) !== -1);
}

function detectInsight_() {
  const raw = getText_(BOW.SHEETS.SHOCK, BOW.CELLS.SHOCK_RATIONALE);
  const text = normalizeText_(raw);

  if (!text) {
    return {
      hasText: false,
      assumptionAware: false,
      contextAware: false,
      changeAware: false,
      precisionTrap: false,
      insightLevel: "none"
    };
  }

  const assumptionAware = hasSignal_(text, SIGNALS.ASSUMPTION);
  const contextAware = hasSignal_(text, SIGNALS.CONTEXT);
  const changeAware = hasSignal_(text, SIGNALS.CHANGE);
  const precisionTrap = hasSignal_(text, SIGNALS.PRECISION_TRAP);

  let insightLevel = "structural";
  if (assumptionAware && contextAware && changeAware) {
    insightLevel = "executive";
  } else if ((assumptionAware && changeAware) || (contextAware && changeAware)) {
    insightLevel = "contextual";
  }

  return {
    hasText: true,
    assumptionAware,
    contextAware,
    changeAware,
    precisionTrap,
    insightLevel
  };
}

/** Minimum insight gate for completion (choice B) */
function insightCompletionStatus_() {
  const insight = detectInsight_();
  if (!insight.hasText || insight.insightLevel === "none") {
    return {
      ready: false,
      reason: "insight_insufficient",
      message: BOW.VOICE.NUDGES.NEED_INSIGHT
    };
  }
  return { ready: true };
}

